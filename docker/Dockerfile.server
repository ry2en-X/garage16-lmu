# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base

# libpq for psycopg (PostgreSQL driver); gosu for controlled privilege
# drop in entrypoint.sh (see that file — needed to chown a freshly
# Docker-created volume mount point before running as the non-root
# `garage` user); build-essential is dropped after install since
# psycopg[binary] ships prebuilt wheels and doesn't need a compiler —
# keeping the final image lean.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    gosu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server/requirements.txt ./server/requirements.txt
# V0.9.7: the exact versions the release was tested with (constraints.txt, release/TEST_REPORT.md)
COPY constraints.txt ./constraints.txt
RUN pip install --no-cache-dir -r server/requirements.txt -c constraints.txt

COPY server ./server
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY docker/entrypoint.sh ./docker/entrypoint.sh
# V0.8.8: the telemetry cleanup tool (README, "Telemetry storage cleanup") was documented as
# "run it inside the server container" but was never copied into the image.
COPY scripts/telemetry_cleanup.py ./scripts/telemetry_cleanup.py
# V0.9.3: car-identity report and the re-check of stored laps, both run inside this container
# (docs/ADMIN_GUIDE.md, "Neu in V0.9.3")
COPY scripts/car_identity_report.py ./scripts/car_identity_report.py
COPY scripts/revalidate_laps.py ./scripts/revalidate_laps.py
# V0.9.7: database vs telemetry files (docs/ADMIN_GUIDE.md, "Neu in V0.9.7"), run inside this container
COPY scripts/consistency_check.py ./scripts/consistency_check.py
# V0.9.8: re-encrypt the client secrets after a key change (docs/RUNBOOKS.md)
COPY scripts/rotate_secret_key.py ./scripts/rotate_secret_key.py
# V0.9.9: integrity sweep / backfill / re-signing, the measurement on labelled real laps, and the
# server-side timing of the lap check (docs/V0_9_9_NAS_ANLEITUNG.md)
COPY scripts/integrity_check.py ./scripts/integrity_check.py
COPY scripts/trackcheck_eval.py ./scripts/trackcheck_eval.py
COPY scripts/bench_server.py ./scripts/bench_server.py

# BUGFIX (found via real deployment testing, 2026-09-25) — see
# Dockerfile.discord_bot's identical comment for the full story: source
# files can arrive with overly-restrictive permissions (observed on a
# NAS deployment where the project went ZIP -> Windows -> File Station
# extract -> NAS). `chown` below fixes ownership but NOT missing read
# bits on the files themselves — this fixes that regardless of what the
# source archive's permissions looked like.
# V0.8.8: strip any Windows line endings (CRLF) from the entrypoint. A CRLF shebang
# (`#!/bin/sh\r`) makes the kernel look for an interpreter called "sh\r" and the
# container dies with "exec ./docker/entrypoint.sh: no such file or directory" —
# which is what a Windows checkout with git autocrlf, or a Windows editor, produces.
RUN sed -i 's/\r$//' ./docker/entrypoint.sh
RUN chmod -R a+rX ./server ./alembic ./alembic.ini ./docker/entrypoint.sh ./scripts
RUN chmod +x ./docker/entrypoint.sh

# Non-root at runtime: entrypoint.sh fixes ownership of the (possibly
# freshly Docker-created, root-owned) telemetry storage volume, then
# drops to `garage` via gosu before running migrations or the app — see
# that script. The image itself still creates `garage` and the local
# fallback storage dir here so both exist regardless of which storage
# path ends up used.
RUN useradd --create-home --shell /bin/bash garage
RUN mkdir -p /app/server_telemetry_storage && chown -R garage:garage /app

EXPOSE 8000

ENTRYPOINT ["./docker/entrypoint.sh"]
