# docker/Caddyfile — ONE file for both access variants, switched by the
# CADDY_SITE_ADDRESS environment variable (set in docker-compose.yml /
# docker-compose.vps.yml — see those files) — no editing this file
# required to switch variants.
#
#   Variant A (Cloudflare Tunnel, default): CADDY_SITE_ADDRESS=:80
#     Caddy serves plain HTTP on the internal Docker network only.
#     Cloudflare's edge terminates the public HTTPS connection and the
#     Tunnel carries traffic to this container — Caddy itself never
#     needs a certificate or a public port.
#
#   Variant B (direct, VPS): CADDY_SITE_ADDRESS=your-domain.example
#     A bare domain (no port) tells Caddy to serve HTTPS on :443 with a
#     real Let's Encrypt certificate, auto-renewed, plus an automatic
#     :80 -> :443 redirect. Requires the domain's DNS to actually point
#     at this host's public IP, and ports 80+443 reachable from the
#     internet (see docker-compose.vps.yml, which publishes them).
#
# BUGFIX (found via real deployment testing, 2026-09-25): every
# reverse_proxy block below explicitly sets `X-Forwarded-Proto: https`.
# Without it, Caddy sets that header based on ITS OWN incoming
# connection — which is plain HTTP in Variant A (Caddy listens on :80,
# Cloudflare's edge/Tunnel terminates the actual public HTTPS). The
# server's GARAGE16_REQUIRE_HTTPS check reads exactly this header and
# was rejecting every request with "HTTPS required" even over a real
# https:// tunnel URL, since Caddy told it the request was HTTP. The
# literal "https" is correct for BOTH variants: in Variant A, anything
# reaching Caddy already passed through Cloudflare's TLS termination; in
# Variant B, Caddy only ever serves this site block over its own real
# HTTPS (:443, plus an automatic :80 redirect) — so a request reaching
# these handlers is HTTPS-aware either way.

# Whose X-Forwarded-For Caddy believes. Only the private ranges: in variant A the request
# arrives from cloudflared on the Docker network (it carries Cloudflare's X-Forwarded-For, which ends
# with the visitor's real address), in variant B straight from the internet — then Caddy discards
# whatever X-Forwarded-For the visitor sent and writes the real peer address itself. Either way the
# app (server/core/client_ip.py, GARAGE16_TRUSTED_PROXIES=private) reads the chain from the right and
# stops at the first address that is not one of ours: a made-up header can no longer change the
# address the rate limits count.
{
    servers {
        trusted_proxies static private_ranges
    }
}

# The security headers of the web pages (the API sets its own, server/main.py). The pages
# load nothing from other hosts and have no inline scripts, so the policy can be strict: no foreign
# scripts, no embedding in other sites (clickjacking of the sign-in and password forms), no MIME
# sniffing. Inline style attributes stay allowed (index.html, charts). A snippet, imported by
# every block that serves pages or their files (the same headers: scripts/release/build_web.py _headers).
(page_headers) {
    # defer: applied last, so a page that the app filled in (server/api/v1/pages.py) gets each header
    # once, not the app's copy and this one
    header {
        defer
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
}

{$CADDY_SITE_ADDRESS:80} {
    # The API lives under /api/v1 (server/api/v1/); the health checks stay at /health.
    @api path /api/* /health /health/*
    handle @api {
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto https
        }
    }

    # The API paths of V1.0.1 and older, for desktop clients 1.0.x (server/api/legacy.py translates
    # them). Precise, because /leaderboard/<track>/<class> and /teams are page addresses now:
    # tests/api/test_api_paths.py keeps these matchers equal to server/api/legacy.py.
    @legacy_api {
        path /accounts/* /telemetry/* /drivers/* /invitations/* /admin/* /teams/* /leaderboard/class/* /leaderboard/car/* /leaderboard/catalog/* /leaderboard/recent
    }
    @legacy_teams {
        path /teams
        not method GET HEAD
    }
    @legacy_legal {
        path /legal
        not header Accept *text/html*
    }
    handle @legacy_teams {
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle @legacy_legal {
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle @legacy_api {
        reverse_proxy server:8000 {
            header_up X-Forwarded-Proto https
        }
    }

    # The files of a release under /v/<version>/... (index.html names them so). The address
    # changes with every release, so a browser may keep them for a year without asking again —
    # instead of 30+ "still the same?" requests per page view.
    handle_path /v/* {
        import page_headers
        uri strip_prefix /{http.request.uri.path.0}
        root * /srv/web
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Everything else: a file of the web folder (icons, robots.txt) — or a page. Skip this whole
    # block (and the web volume) when the website is served by Cloudflare Pages instead
    # (docs/DEPLOYMENT.md): the API blocks above are all this proxy needs then.
    handle {
        import page_headers
        root * /srv/web
        @file file
        handle @file {
            # `no-cache` = keep a copy, but ask before using it (a cheap 304)
            header Cache-Control "no-cache"
            file_server
        }
        # A page address (/leaderboard/fuji-speedway/hypercar, /driver/moritz-lachnit, …):
        # index.html with the page's own title and link preview, 404 for an unknown address —
        # filled in by the server (server/api/v1/pages.py), the browser's router draws the page.
        handle {
            rewrite * /api/v1/public/page
            reverse_proxy server:8000 {
                header_up X-Forwarded-Proto https
                header_up X-Garage16-Page-Path {http.request.orig_uri.path}
            }
        }
    }

    # Upload body size — see server/core/config.py's max_upload_bytes (default
    # 50 MiB). Keep this a little above that so Caddy doesn't reject a
    # borderline-sized upload before the app gets to enforce its own
    # limit with a proper JSON error body.
    request_body {
        max_size 55MB
    }

    encode zstd gzip

    # The access log holds IP addresses — kept 7 days (privacy policy, section 4)
    log {
        output file /data/access.log {
            roll_size 50MB
            roll_keep 5
            roll_keep_for 168h
        }
    }
}
