# .env.example — copy to .env and fill in real values before running
# `docker compose up`. Never commit the real .env.
#
# See README.md for the full walkthrough (Synology NAS or VPS).

# =====================================================================
# PostgreSQL
# =====================================================================
POSTGRES_DB=garage16
POSTGRES_USER=garage16
POSTGRES_PASSWORD=                     # REQUIRED — generate: openssl rand -base64 24
# Docker-secrets alternative: leave this blank, uncomment
# POSTGRES_PASSWORD_FILE in docker-compose.yml, and put the password in
# ./secrets/postgres_password.txt instead (see that file's `secrets:`
# block at the bottom). Same applies to the other REQUIRED values below.

# =====================================================================
# Server
# =====================================================================
LMU_GARAGE_ENV=production
# REQUIRED in production — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LMU_GARAGE_SECRET_KEY=
# V0.9.9 — the key of the server's integrity MACs (stored lap files, audit log; server/integrity.py).
# Optional: empty = derived from LMU_GARAGE_SECRET_KEY. Recommended: its own random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotation like LMU_GARAGE_SECRET_KEY: "<new>,<old>" (the first signs, all verify), then
# scripts/integrity_check.py --apply --resign (docs/RUNBOOKS.md). Never lose it: without it the
# signatures can no longer vouch for the stored laps (they are reported, not deleted).
LMU_GARAGE_INTEGRITY_KEY=
# V0.9.9 — days the audit log (integrity, validation, admin events) is kept. Default 365, minimum 30.
# LMU_GARAGE_AUDIT_RETENTION_DAYS=365
# REQUIRED in production — closes open self-registration. Any long random string.
LMU_GARAGE_REGISTRATION_SECRET=
# REQUIRED to use /admin/* moderation endpoints at all.
LMU_GARAGE_ADMIN_TOKEN=
# Your real frontend origin(s), comma-separated, no trailing slash. Garage16
# is served at https://garage16.de (web app and API on the same address).
# If the web/ frontend were deployed separately (Cloudflare Pages), include
# THAT domain here too, e.g.  https://garage16.de,https://garage16.pages.dev
LMU_GARAGE_CORS_ORIGINS=https://garage16.de
# Rejects uploads from clients older than this — bump after shipping a
# client-breaking fix (see server/config.py).
LMU_GARAGE_MIN_CLIENT_VERSION=0.5.3
# "text" or "json" — see server/main.py's logging setup.
LMU_GARAGE_LOG_FORMAT=json

# --- Rate limits (requests per window; see server/rate_limit.py) ---
# Defaults are usually fine — override only if you have a concrete reason.
# LMU_GARAGE_RATELIMIT_REGISTER_MAX=5
# LMU_GARAGE_RATELIMIT_REGISTER_WINDOW=3600
# LMU_GARAGE_RATELIMIT_UPLOAD_MAX=120
# LMU_GARAGE_RATELIMIT_UPLOAD_WINDOW=3600

# --- DB connection pool (PostgreSQL only — see server/config.py) ---
# LMU_GARAGE_DB_POOL_SIZE=5
# LMU_GARAGE_DB_MAX_OVERFLOW=10

# --- Email (V0.6.9 — password reset; see server/email_provider.py) ---
# "development" (default) logs the email instead of sending it — fine for
# a NAS/localhost deployment with no real mail infrastructure. Set to
# "smtp" and fill in the values below once you have real SMTP credentials.
# LMU_GARAGE_EMAIL_PROVIDER=development
# LMU_GARAGE_SMTP_HOST=
# LMU_GARAGE_SMTP_PORT=587
# LMU_GARAGE_SMTP_USER=
# LMU_GARAGE_SMTP_PASSWORD=
# LMU_GARAGE_SMTP_FROM=garage16@garage16.de
#
# Gmail as the sender (see docs/ADMIN_GUIDE.md, chapter 10, part B): needs 2-step
# verification and an app password (myaccount.google.com/apppasswords), no spaces:
# LMU_GARAGE_EMAIL_PROVIDER=smtp
# LMU_GARAGE_SMTP_HOST=smtp.gmail.com
# LMU_GARAGE_SMTP_PORT=587
# LMU_GARAGE_SMTP_USER=garage16.lmu@gmail.com
# LMU_GARAGE_SMTP_PASSWORD=<app password>
# LMU_GARAGE_SMTP_FROM=garage16.lmu@gmail.com
#
# The web frontend's own origin — used to build the link inside a
# verification / password-reset email. Must match wherever web/ is actually
# served from: garage16.de.
LMU_GARAGE_FRONTEND_URL=https://garage16.de

# --- Server migration (V0.7.2 §7 — NAS -> VPS/domain cutover) ---
# Set this on the OLD instance once you're decommissioning it in favor
# of a new one. It keeps answering normally, but GET /health starts
# advertising the new URL — running desktop clients notice on their own
# (checked every ~10 minutes) and switch automatically, no action needed
# from friends. This only works when BOTH the old and the new server use
# https:// (the client refuses to follow a move announced over plain
# http, which anyone on the network could fake). Leave unset normally.
# LMU_GARAGE_MIGRATED_TO=https://garage16.your-new-domain.example

# --- Desktop client updates (V0.8.6) ---
# Where a desktop client that is too old for this server sends its user:
# shown in the client window as an "Open download page" button. Point it
# at wherever you put Garage16-Client-Setup.exe (a GitHub release page, a
# shared-link URL, ...). Optional — without it the client just tells the
# friend to ask whoever runs the server. Must be http(s); the client
# ignores anything else. Raise LMU_GARAGE_MIN_CLIENT_VERSION (above) to
# actually require the new version.
# LMU_GARAGE_CLIENT_DOWNLOAD_URL=https://example.com/garage16-download
#
# V0.9.2: the client comes in two editions. The URL above is the plain "Client"
# (Garage16-Client-Setup.exe); this one is "Client + analysis app"
# (Garage16-Client-Analysis-Setup.exe). Both are shown side by side on the
# website's Download page (#/download) — a missing one shows as "not available
# yet" — and a too-old client is sent to the download of its own edition.
# LMU_GARAGE_CLIENT_APP_DOWNLOAD_URL=https://example.com/garage16-analysis-download

# --- Security (V0.7.2, server/main.py) ---
# The interactive API docs at /docs and /redoc are OFF by default in
# production (LMU_GARAGE_ENV != development) — they document the full
# API surface for free, which is unnecessary reconnaissance value to
# expose on a public deployment by default. Uncomment to re-enable them
# in production anyway (e.g. while building an alternative client).
# LMU_GARAGE_ENABLE_API_DOCS=true

# V0.9.3.1 — track limits: which of Garage16's own MEASUREMENTS may invalidate a lap
# on their own. Empty (default): they only send the lap to the admin review queue
# (Admin → Review); LMU's own verdict (its invalidation flag, its count flag) always
# invalidates, this setting cannot weaken it. Set codes here only after real LMU
# recordings confirmed the measurement (docs/LMU_VERIFICATION_PROTOCOL.md, V0.9.3.1).
# Possible: track_limits_points, late_track_limits, four_wheels_off, edge_exceeded,
# short_distance, penalty_added, client_invalid_unexplained, game_last_lap_time_withdrawn,
# sector_times_implausible
# LMU_GARAGE_TRACK_LIMITS_INVALIDATING=

# --- Worker count (docker/entrypoint.sh) ---# Leave at 1 unless you've replaced server/rate_limit.py's in-memory
# limiter with a shared (Redis-backed) one first — see that module's
# multi-worker caveat.
LMU_GARAGE_WORKERS=1

# V0.9.8 — whose X-Forwarded-For is believed (server/client_ip.py): comma-separated addresses /
# networks, or "private" (the Docker network — the app publishes no port, only the reverse proxy
# reaches it; this is what docker-compose uses when unset). The chain is read from the right, so a
# header a visitor writes himself can no longer change the address the rate limits count.
# LMU_GARAGE_TRUSTED_PROXIES=private

# =====================================================================
# Discord bot
# =====================================================================
# From https://discord.com/developers/applications — REQUIRED to run the bot.
DISCORD_BOT_TOKEN=

# =====================================================================
# Reverse proxy / public access — pick ONE variant
# =====================================================================
#
# --- Variant A: Cloudflare Tunnel (Synology NAS, no open router port) ---
# Leave CADDY_SITE_ADDRESS unset (defaults to ":80" — internal only).
# Create the tunnel in the Cloudflare Zero Trust dashboard first (see
# docs/ADMIN_GUIDE.md chapter 10 — Public Hostname: garage16.de, empty
# subdomain, service HTTP, URL reverse_proxy:80), then paste its token here:
CLOUDFLARE_TUNNEL_TOKEN=
# Run with:  docker compose --profile tunnel up -d
#
# --- Variant B: direct reverse proxy with automatic HTTPS (VPS) ---
# Set this to your real domain (DNS must already point at this host's
# public IP), leave CLOUDFLARE_TUNNEL_TOKEN blank:
# CADDY_SITE_ADDRESS=garage16.example.com
# Run with:  docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d

# =====================================================================
# Backups (optional containerized option — see README.md's "Backups")
# =====================================================================
# Run with:  docker compose --profile backup up -d
# Leave BACKUP_HOST_PATH unset to use a Docker-managed volume, or set it
# to a real path (a second disk's mount point, a cloud-sync folder) so
# backups land somewhere durable outside Docker's own storage:
# BACKUP_HOST_PATH=/volume2/backups/garage16
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
