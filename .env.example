# .env.example — copy to .env and fill in real values before running
# `docker compose up`. Never commit the real .env.
#
# See README.md for the full walkthrough (Synology NAS or VPS).

# =====================================================================
# PostgreSQL
# =====================================================================
POSTGRES_DB=garage16
POSTGRES_USER=garage16
POSTGRES_PASSWORD=                     # REQUIRED — generate: openssl rand -base64 24
# Docker-secrets alternative: leave this blank, uncomment
# POSTGRES_PASSWORD_FILE in docker-compose.yml, and put the password in
# ./secrets/postgres_password.txt instead (see that file's `secrets:`
# block at the bottom). Same applies to the other REQUIRED values below.

# =====================================================================
# Server
# =====================================================================
GARAGE16_ENV=production
# REQUIRED in production — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARAGE16_SECRET_KEY=
# The key of the server's integrity MACs (stored lap files, audit log; server/laps/integrity.py).
# Optional: empty = derived from GARAGE16_SECRET_KEY. Recommended: its own random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotation like GARAGE16_SECRET_KEY: "<new>,<old>" (the first signs, all verify), then
# scripts/ops/integrity_check.py --apply --resign (docs/RUNBOOKS.md). Never lose it: without it the
# signatures can no longer vouch for the stored laps (they are reported, not deleted).
GARAGE16_INTEGRITY_KEY=
# Days the audit log (integrity, validation, admin events) is kept. Default 365, minimum 30.
# GARAGE16_AUDIT_RETENTION_DAYS=365
# Who may create an account — set ONE of the two, the server refuses to start with neither:
#   GARAGE16_REGISTRATION_SECRET  any long random string: only people who know it can sign up
#                                   (closed circle; the sign-up form then asks for it)
#   GARAGE16_OPEN_REGISTRATION=1  anybody can sign up on the website (terms and minimum age are
#                                   confirmed on the form). The secret may stay set: admins and
#                                   scripts can still use it with POST /accounts/register.
GARAGE16_REGISTRATION_SECRET=
# GARAGE16_OPEN_REGISTRATION=1
# Minimum age for an account (terms of use, privacy policy, sign-up form). Default 16.
# GARAGE16_MIN_AGE=16
#
# The operator shown in the legal notice (Impressum) and privacy policy (website → Legal).
# Kept here, not in the code: the repository is public. Address lines separated by "|".
# Shown only on the "Legal" page (not indexed by search engines). Empty = the page says the
# details are missing.
# GARAGE16_OPERATOR_NAME=Erika Mustermann
# GARAGE16_OPERATOR_ADDRESS=Musterstraße 1|12345 Musterstadt
# GARAGE16_OPERATOR_EMAIL=kontakt@example.com
#
# Account rules for an open server (defaults shown; usually nothing to change):
# The desktop client connects only after the account's email was confirmed (0 = off, e.g. for a
# closed circle without SMTP).
# GARAGE16_REQUIRE_EMAIL_VERIFICATION=1
# Sign-ups whose email was never confirmed (no laps, no team) are deleted after this many days
# (0 = never).
# GARAGE16_UNVERIFIED_ACCOUNT_DAYS=7
# Fair play: a driver with fewer official laps than this whose lap beats the Garage16 Best of
# others is held for you (Admin → review queue) before it counts (0 = off).
# GARAGE16_NEW_DRIVER_REVIEW_LAPS=10
# PCs one account may have connected at once (the one used longest ago is disconnected).
# GARAGE16_MAX_DEVICES=5
# The newest desktop client — older clients show "a new version is available". Empty = the client
# released together with this server.
# GARAGE16_LATEST_CLIENT_VERSION=
# REQUIRED to use /admin/* moderation endpoints at all.
GARAGE16_ADMIN_TOKEN=
# Your real frontend origin(s), comma-separated, no trailing slash. Garage16
# is served at https://garage16.de (web app and API on the same address).
# If the web/ frontend were deployed separately (Cloudflare Pages), include
# THAT domain here too, e.g.  https://garage16.de,https://garage16.pages.dev
GARAGE16_CORS_ORIGINS=https://garage16.de
# Rejects uploads from clients older than this — bump after shipping a
# client-breaking fix (see server/core/config.py).
GARAGE16_MIN_CLIENT_VERSION=0.5.3
# "text" or "json" — see server/main.py's logging setup.
GARAGE16_LOG_FORMAT=json

# --- Rate limits (requests per window; see server/core/rate_limit.py) ---
# Defaults are usually fine — override only if you have a concrete reason.
# GARAGE16_RATELIMIT_REGISTER_MAX=5
# GARAGE16_RATELIMIT_REGISTER_WINDOW=3600
# GARAGE16_RATELIMIT_UPLOAD_MAX=120
# GARAGE16_RATELIMIT_UPLOAD_WINDOW=3600

# --- DB connection pool (PostgreSQL only — see server/core/config.py) ---
# GARAGE16_DB_POOL_SIZE=5
# GARAGE16_DB_MAX_OVERFLOW=10

# --- Email ---
# "development" (default) logs the email instead of sending it — fine for
# a NAS/localhost deployment with no real mail infrastructure. Set to
# "smtp" and fill in the values below once you have real SMTP credentials.
# GARAGE16_EMAIL_PROVIDER=development
# GARAGE16_SMTP_HOST=
# GARAGE16_SMTP_PORT=587
# GARAGE16_SMTP_USER=
# GARAGE16_SMTP_PASSWORD=
# GARAGE16_SMTP_FROM=garage16@garage16.de
#
# Gmail as the sender (see docs/ADMIN_GUIDE.md, chapter 10, part B): needs 2-step
# verification and an app password (myaccount.google.com/apppasswords), no spaces:
# GARAGE16_EMAIL_PROVIDER=smtp
# GARAGE16_SMTP_HOST=smtp.gmail.com
# GARAGE16_SMTP_PORT=587
# GARAGE16_SMTP_USER=garage16.lmu@gmail.com
# GARAGE16_SMTP_PASSWORD=<app password>
# GARAGE16_SMTP_FROM=garage16.lmu@gmail.com
#
# The web frontend's own origin — used to build the link inside a
# verification / password-reset email. Must match wherever web/ is actually
# served from: garage16.de.
GARAGE16_FRONTEND_URL=https://garage16.de

# --- Server migration ---
# Set this on the OLD instance once you're decommissioning it in favor
# of a new one. It keeps answering normally, but GET /health starts
# advertising the new URL — running desktop clients notice on their own
# (checked every ~10 minutes) and switch automatically, no action needed
# from friends. This only works when BOTH the old and the new server use
# https:// (the client refuses to follow a move announced over plain
# http, which anyone on the network could fake). Leave unset normally.
# GARAGE16_MIGRATED_TO=https://garage16.your-new-domain.example

# --- Desktop client updates ---
# Where a desktop client that is too old for this server sends its user:
# shown in the client window as an "Open download page" button. Point it
# at wherever you put Garage16-Client-Setup.exe (a GitHub release page, a
# shared-link URL, ...). Optional — without it the client just tells the
# friend to ask whoever runs the server. Must be http(s); the client
# ignores anything else. Raise GARAGE16_MIN_CLIENT_VERSION (above) to
# actually require the new version.
# GARAGE16_CLIENT_DOWNLOAD_URL=https://example.com/garage16-download
#
# The client comes in two editions. The URL above is the plain "Client"
# (Garage16-Client-Setup.exe); this one is "Client + analysis app"
# (Garage16-Client-Analysis-Setup.exe). Both are shown side by side on the
# website's Download page (#/download) — a missing one shows as "not available
# yet" — and a too-old client is sent to the download of its own edition.
# GARAGE16_CLIENT_APP_DOWNLOAD_URL=https://example.com/garage16-analysis-download
#
# Both may stay EMPTY — then they point at the installers of the newest release of this
# public GitHub repository (…/releases/latest/download/Garage16-Client-Setup.exe and
# …/Garage16-Client-Analysis-Setup.exe), and the page with all files of that release is offered
# as a fallback. Another repository: set it here; GARAGE16_GITHUB_REPO= (empty) = no defaults.
# GARAGE16_GITHUB_REPO=ry2en-X/garage16-lmu
# GARAGE16_CLIENT_RELEASE_PAGE_URL=https://github.com/ry2en-X/garage16-lmu/releases/latest

# --- Security ---
# The interactive API docs at /docs and /redoc are OFF by default in
# production (GARAGE16_ENV != development) — they document the full
# API surface for free, which is unnecessary reconnaissance value to
# expose on a public deployment by default. Uncomment to re-enable them
# in production anyway (e.g. while building an alternative client).
# GARAGE16_ENABLE_API_DOCS=true

# Track limits: which of Garage16's own MEASUREMENTS may invalidate a lap
# on their own. Empty (default): they only send the lap to the admin review queue
# (Admin → Review); LMU's own verdict (its invalidation flag, its count flag) always
# invalidates, this setting cannot weaken it. Set codes here only after real LMU
# recordings confirmed the measurement (docs/LMU_VERIFICATION_PROTOCOL.md, V0.9.3.1).
# Possible: track_limits_points, late_track_limits, four_wheels_off, edge_exceeded,
# short_distance, penalty_added, client_invalid_unexplained, game_last_lap_time_withdrawn,
# sector_times_implausible
# GARAGE16_TRACK_LIMITS_INVALIDATING=

# --- Worker count (docker/entrypoint.sh) ---
# Leave at 1 unless you've replaced server/core/rate_limit.py's in-memory
# limiter with a shared (Redis-backed) one first — see that module's
# multi-worker caveat.
GARAGE16_WORKERS=1

# Whose X-Forwarded-For is believed (server/core/client_ip.py): comma-separated addresses /
# networks, or "private" (the Docker network — the app publishes no port, only the reverse proxy
# reaches it; this is what docker-compose uses when unset). The chain is read from the right, so a
# header a visitor writes himself can no longer change the address the rate limits count.
# GARAGE16_TRUSTED_PROXIES=private

# V1.0.2 — the website on Cloudflare Pages (docs/DEPLOYMENT.md, "The website on Cloudflare Pages"):
# the shared secret the Pages function sends as X-Garage16-Edge-Key together with the visitor's
# address (X-Garage16-Client-IP). Only a request carrying this key may set the address the rate
# limits count. Long random value (openssl rand -hex 32); the same value goes into the Pages
# project's environment variables. Unset = the header is ignored (no Pages).
# GARAGE16_EDGE_KEY=
#
# Where the server reads index.html to answer page addresses with the right title/preview
# (docker-compose mounts ./web at /srv/web and sets this; outside Docker: the web/ folder).
# GARAGE16_WEB_DIR=/srv/web
#
# V1.0.2: every setting is now called GARAGE16_*. The old LMU_GARAGE_* names are still read when
# the new one is not set, so an old .env keeps working unchanged.

# =====================================================================
# Discord bot
# =====================================================================
# From https://discord.com/developers/applications — REQUIRED to run the bot.
DISCORD_BOT_TOKEN=
# V1.0.3: seconds a record announcement waits for a newer improvement of the same record before it
# is posted (one message per session instead of one per lap). 0 = post at once. Default 300.
# GARAGE16_DISCORD_DIGEST_S=300

# =====================================================================
# Reverse proxy / public access — pick ONE variant
# =====================================================================
#
# --- Variant A: Cloudflare Tunnel (Synology NAS, no open router port) ---
# Leave CADDY_SITE_ADDRESS unset (defaults to ":80" — internal only).
# Create the tunnel in the Cloudflare Zero Trust dashboard first (see
# docs/ADMIN_GUIDE.md chapter 10 — Public Hostname: garage16.de, empty
# subdomain, service HTTP, URL reverse_proxy:80), then paste its token here:
CLOUDFLARE_TUNNEL_TOKEN=
# Run with:  docker compose --profile tunnel up -d
#
# --- Variant B: direct reverse proxy with automatic HTTPS (VPS) ---
# Set this to your real domain (DNS must already point at this host's
# public IP), leave CLOUDFLARE_TUNNEL_TOKEN blank:
# CADDY_SITE_ADDRESS=garage16.example.com
# Run with:  docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d

# =====================================================================
# Backups (optional containerized option — see README.md's "Backups")
# =====================================================================
# Run with:  docker compose --profile backup up -d
# Leave BACKUP_HOST_PATH unset to use a Docker-managed volume, or set it
# to a real path (a second disk's mount point, a cloud-sync folder) so
# backups land somewhere durable outside Docker's own storage:
# BACKUP_HOST_PATH=/volume2/backups/garage16
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14

# --- Stored lap figures after an update (V1.0.3, server/ops/figures_refresh.py) ---
# After a server update the laps whose figures (fuel, tyres, pit lane, traffic …) an older analysis
# computed are recomputed in the background, in small batches, until none is left. 0 = off (then:
# python -m scripts.ops.consistency_check --recompute-figures by hand).
# GARAGE16_REFRESH_FIGURES=1
